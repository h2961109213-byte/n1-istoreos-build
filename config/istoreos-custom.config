# ============================================================
# iStoreOS 自编译追加配置 v3（追加到 .config 末尾后执行 make defconfig）
# 设备：Phicomm N1（S905D，amlogic/meson，内核 6.12.94，基于 iStoreOS 25.12.5 r0-0465e2c）
# 注意：N1 只有 USB 2.0、无 PCIe，5G 模组需外接带独立供电的 USB 转接盒
# 注意：当前内核未开启 BTF，dae 现在无法运行；本配置开启 BTF 后可修复（OpenWrt 会自动编译 dwarves/pahole）
# 变更：+honk 依赖  +移动通信模组(QModem: RM500Q / FM350 等)  保留 daede  -PassWall
# 由 GitHub Actions 工作流自动拼接到 .config（QModem / OAF 源由工作流自动添加）
# ============================================================

# ---------- 编译全部内核模块为独立安装包(=m，不进固件，不占 rootfs) ----------
# 产物里会得到与本固件内核完全匹配的 kmod 包，日后需要新模块可直接离线安装
CONFIG_ALL_KMODS=y

# ---------- Docker（原固件内置，保持一致；数据目录在 USB 硬盘不受影响） ----------
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_NET_OVERLAY=y
CONFIG_DOCKER_STO_EXT4=y
CONFIG_DOCKER_STO_BTRFS=y

# ---------- OAF 行为管理（带内核模块，必须编入） ----------
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_open-app-filter=y

# ---------- 分区大小（必须与当前设备一致：boot 64M / rootfs 256M） ----------
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=256

# ---------- 移除的插件 ----------
# CONFIG_PACKAGE_luci-app-passwall is not set

# ---------- honk 所需（固件内只编入内核模块，honk 本体升级后 apk 安装） ----------
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y

# ---------- daede（dae）：内核支持 + 依赖模块 ----------
# daed 本体体积较大，rootfs 余量紧张；升级后用 daeuniverse 源安装：apk add daed@daeuniverse luci-app-daed@daeuniverse
# CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_BPF_TOOLCHAIN_HOST=y

# ---------- 移动通信模组：QModem ----------
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
# 拨号协议备用（官方 LuCI）
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
# AT 串口通道（RM500Q / FM350 通用）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
# 数据通道
#   移远 RM500Q（USB）：QMI / MBIM / ECM / RNDIS
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
#   广和通 FM350（USB）：NCM / RNDIS
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
# PCIe 接口模组驱动（仅当盒子有 M.2/PCIe 插槽时打开；Amlogic 盒子多数只有 USB）
# CONFIG_PACKAGE_kmod-mtk-t7xx=y          # FM350 PCIe
# CONFIG_PACKAGE_kmod-mhi-net=y           # RM500Q PCIe
# CONFIG_PACKAGE_kmod-mhi-wwan-ctrl=y
# CONFIG_PACKAGE_kmod-mhi-wwan-mbim=y
# 注：USB_XHCI_HCD / USB_STORAGE / EXT4_FS 当前内核已内建(=y)，无需额外 kmod

# ---------- 当前系统已安装的 kmod（全部编入，避免 vermagic 问题） ----------
# 无线 / 网卡
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-usb-common=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# 虚拟网络 / Docker
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-ipt-physdev=y

# Netfilter / nftables / iptables（OpenClash 透明代理仍需要）
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-nf-log=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y

# OAF 行为管理
CONFIG_PACKAGE_kmod-oaf=y

# PPPoE 拨号
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y

# 文件系统 / 存储 / RAID
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-fs-netfs=y
CONFIG_PACKAGE_kmod-fs-smbfs-common=y
CONFIG_PACKAGE_kmod-md-mod=y
CONFIG_PACKAGE_kmod-md-raid0=y
CONFIG_PACKAGE_kmod-md-raid1=y
CONFIG_PACKAGE_kmod-md-raid10=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-ucs2-utils=y

# 输入 / 显示
CONFIG_PACKAGE_kmod-fb=y
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-input-evdev=y

# 加密 / 库（多数会被自动依赖选中，列出以防遗漏）
CONFIG_PACKAGE_kmod-asn1-decoder=y
CONFIG_PACKAGE_kmod-oid-registry=y
CONFIG_PACKAGE_kmod-dnsresolver=y
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-blake2b=y
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-geniv=y
CONFIG_PACKAGE_kmod-crypto-gf128=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha3=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-xxhash=y
CONFIG_PACKAGE_kmod-lib-crc-ccitt=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-raid6=y
CONFIG_PACKAGE_kmod-lib-xor=y
CONFIG_PACKAGE_kmod-lib-xxhash=y
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# ============================================================
# 禁用在内核 6.12 下编译失败、且 N1 用不上的模块
# （CONFIG_ALL_KMODS=y 会把全部内核模块都编成独立安装包；
#  显式 "# CONFIG_PACKAGE_... is not set" 可覆盖 ALL_KMODS 的默认值。
#  2026-11-17 run #2 后首版；2026-11-18 run #4 后按实际生成
#  的 .config 逐项核对修正：补 kmod-r8168-rss、kmod-pcie_mhi
#  改下划线、补 kmod-dahdi-dummy、新增 kmod-ath5k。）
# ============================================================
# Realtek PCIe 有线网卡驱动（N1 网口为 RTL8211F PHY，
# 由内核内建的 meson8b-dwmac 驱动，不用这些外置驱动）
# CONFIG_PACKAGE_kmod-r8101 is not set
# CONFIG_PACKAGE_kmod-r8125 is not set
# CONFIG_PACKAGE_kmod-r8125-rss is not set
# CONFIG_PACKAGE_kmod-r8126 is not set
# CONFIG_PACKAGE_kmod-r8126-rss is not set
# CONFIG_PACKAGE_kmod-r8127 is not set
# CONFIG_PACKAGE_kmod-r8127-rss is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_kmod-r8168-rss is not set
# Quectel MHI（PCIe 形态 5G 模组驱动；N1 的 5G 模组走 USB，不用 MHI；
# 符号名是下划线的 kmod-pcie_mhi，以 quectel_MHI/Makefile 注册名为准）
# CONFIG_PACKAGE_kmod-pcie_mhi is not set
# DAHDI 电话接口（N1 没有电话卡硬件）
# CONFIG_PACKAGE_kmod-dahdi is not set
# CONFIG_PACKAGE_kmod-dahdi-dummy is not set
# CONFIG_PACKAGE_kmod-dahdi-echocan-oslec is not set
# CONFIG_PACKAGE_kmod-dahdi-hfcs is not set
# ath5k（老 Atheros PCI 无线网卡驱动；run #4 中 ath5k.ko 未产出，
# 打包 kmod-ath5k 时缺文件导致 mac80211 失败；N1 用不上）
# CONFIG_PACKAGE_kmod-ath5k is not set
# 开启分包编译日志：失败时产物里带每个包的 compile.txt，便于定位
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_BUILD_LOG_DIR=""
