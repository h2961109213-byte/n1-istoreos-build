# ============================================================
# iStoreOS 自编译完整配置 v4（对齐作者原版 ROM + 新增需求 - PassWall）
# 设备：Phicomm N1（S905D，amlogic/meson，分区：p1=64M / p2=256M / p3=2048M）
# 变更：+honk 依赖(NFQUEUE)  +dae 原生内核 BTF  +移动通信模组(QModem: RM500Q/FM350)
#       +完整保留原版 ROM 内置功能(LuCI后台/iStore/QuickStart/DiskMan/WiFi/OpenClash/daede/AdGuardHome/Lucky/OAF/Docker/主题)
#       -移除 PassWall 及其庞大的代理后端核心
# ============================================================

# ---------- 编译全部内核模块为独立安装包(=m，不占 rootfs) & 开启分包构建日志 ----------
CONFIG_ALL_KMODS=y
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_BUILD_LOG_DIR=""

# ---------- 镜像格式：仅输出 SquashFS（保留 N1 原生 256MiB 分区布局，关闭会撑爆 256MiB 的未压缩 ext4 镜像） ----------
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------- 禁用无 PCI 总线 (amlogic/meson # CONFIG_PCI is not set) 下会编译/打包失败的 PCI/DAHDI 内核模块 ----------
# 1. Realtek PCIe 网卡与 QModem PCIe MHI / DAHDI
# CONFIG_PACKAGE_kmod-r8101 is not set
# CONFIG_PACKAGE_kmod-r8125 is not set
# CONFIG_PACKAGE_kmod-r8125-rss is not set
# CONFIG_PACKAGE_kmod-r8126 is not set
# CONFIG_PACKAGE_kmod-r8126-rss is not set
# CONFIG_PACKAGE_kmod-r8127 is not set
# CONFIG_PACKAGE_kmod-r8127-rss is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_kmod-r8168-rss is not set
# CONFIG_PACKAGE_kmod-pcie_mhi is not set
# CONFIG_PACKAGE_kmod-dahdi is not set
# CONFIG_PACKAGE_kmod-dahdi-dummy is not set
# CONFIG_PACKAGE_kmod-dahdi-echocan-oslec is not set
# CONFIG_PACKAGE_kmod-dahdi-hfcs is not set

# 2. mac80211 / backports 下的 PCI 无线网卡驱动
# CONFIG_PACKAGE_kmod-ath5k is not set
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_kmod-ath10k-smallbuffers is not set
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
# CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_kmod-ath12k is not set
# CONFIG_PACKAGE_kmod-iwlwifi is not set
# CONFIG_PACKAGE_kmod-mwifiex-pcie is not set
# CONFIG_PACKAGE_kmod-mwl8k is not set
# CONFIG_PACKAGE_kmod-owl-loader is not set
# CONFIG_PACKAGE_kmod-rt2800-pci is not set
# CONFIG_PACKAGE_kmod-rt2x00-pci is not set
# CONFIG_PACKAGE_kmod-rt61-pci is not set
# CONFIG_PACKAGE_kmod-rtl8192ce is not set
# CONFIG_PACKAGE_kmod-rtl8192de is not set
# CONFIG_PACKAGE_kmod-rtl8192se is not set
# CONFIG_PACKAGE_kmod-rtl8723be is not set
# CONFIG_PACKAGE_kmod-rtl8821ae is not set
# CONFIG_PACKAGE_kmod-rtlwifi-pci is not set
# CONFIG_PACKAGE_kmod-rtw88-8723de is not set
# CONFIG_PACKAGE_kmod-rtw88-8814ae is not set
